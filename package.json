{
  "name": "openscript-ch-website",
  "version": "0.8.2",
  "private": true,
  "description": "Our organizations website.",
  "homepage": "https://github.com/openscript-ch/openscript.ch",
  "bugs": {
    "url": "https://github.com/openscript-ch/openscript.ch/issues"
  },
  "license": "0BSD",
  "author": "openscript Ltd.",
  "repository": "github:openscript-ch/openscript.ch",
  "type": "module",
  "scripts": {
    "predev": "pnpm build:sprite",
    "prebuild": "pnpm build:sprite",
    "dev": "astro dev --host",
    "build": "astro check && astro build",
    "build:sprite": "svg-sprite -S --Ss sprite.svg --stack-dest . --Sx --stack-example-template res/sprite/sprite.json.mustache --stack-example-dest ../res/sprite/sprite.json -l verbose -D public res/sprite/*.svg",
    "preview": "astro preview --host",
    "astro": "astro",
    "astro:check": "astro check",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run astro:check",
    "version": "changeset version",
    "release": "changeset publish",
    "tag": "changeset tag"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@nanostores/i18n": "^1.3.3",
    "@openscript/svg-sprite-ng": "^4.0.0",
    "astro": "^7.3.2",
    "astro-loader-i18n": "^1.0.0",
    "astro-nanostores-i18n": "^1.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "limax": "^4.2.3",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.4",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@anolilab/unplugin-favicons": "^4.0.1",
    "@astrojs/compiler-rs": "^0.5.2",
    "@changesets/cli": "^3.0.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "favicons": "^7.3.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier-plugin-astro": "^1.1.1",
    "sirv": "^3.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
