{
  "name": "openscript-ch-website",
  "private": true,
  "description": "Our organizations website.",
  "type": "module",
  "version": "0.8.0",
  "license": "0BSD",
  "author": "openscript Ltd.",
  "homepage": "https://github.com/openscript-ch/openscript.ch",
  "bugs": {
    "url": "https://github.com/openscript-ch/openscript.ch/issues"
  },
  "repository": "github:openscript-ch/openscript.ch",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "predev": "pnpm build:sprite",
    "prebuild": "pnpm build:sprite",
    "dev": "astro dev --host",
    "build": "astro check && astro build",
    "build:sprite": "svg-sprite -S --Ss sprite.svg --stack-dest . --Sx --stack-example-template res/sprite/sprite.json.mustache --stack-example-dest ../res/sprite/sprite.json -l verbose -D public res/sprite/*.svg",
    "preview": "astro preview --host",
    "astro": "astro",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "check": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "version": "changeset version",
    "release": "changeset publish",
    "tag": "changeset tag"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@nanostores/i18n": "^1.3.3",
    "astro": "^7.1.6",
    "astro-loader-i18n": "^1.0.0",
    "astro-nanostores-i18n": "^1.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "limax": "^4.2.3",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.3",
    "simple-git": "^3.36.0",
    "svg-sprite": "^2.0.4",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@anolilab/unplugin-favicons": "^3.0.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@openscript/unplugin-favicons": "^1.1.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "favicons": "^7.3.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sirv": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  }
}
