---
import { currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection } from "astro:content";
import Accordion from "../../components/accordion/Accordion.astro";
import AccordionItem from "../../components/accordion/AccordionItem.astro";
import Heading from "../../components/accordion/Heading.astro";
import { Image } from "astro:assets";

const locale = currentLocale.get();
const projects = await getCollection("referenceProjects", (entry) => entry.data.locale === locale);
---

<Accordion>
  {projects.map((project, i) => (
    <AccordionItem id={project.id} name={project.data.softwareName} variant="minimal" open={i === 0}>
      <div slot="pretext">
        <Heading level="h3" size="h6" class="title" slot="title">
          {project.data.softwareName}
          <div class="title-icon">
            <Image height="30" src={project.data.logo} alt={project.data.softwareName} />
          </div>
        </Heading>
        <div class="preview">
          <span>{project.data.summary}</span>
          <div class="image">
            <Image height={120} src={project.data.logo} alt={project.data.softwareName} />
          </div>
        </div>
      </div>
      <div class="content">
        {project.data.summary}
        {project.data.image && (
          <Image
            src={project.data.image}
            alt={project.data.softwareName}
            widths={[300, 400, 800, 1200, 1800, 2200]}
            sizes="(max-width: 800px) 100vw, 75vw"
          />
        )}
      </div>
    </AccordionItem>
  ))}
</Accordion>

<style>
  .preview {
    display: flex;
    justify-content: space-between;
    gap: var(--size-gutter-huge);

    span {
      width: 75%;
    }

    .image {
      display: flex;
      flex-grow: 1;
      justify-content: center;
    }
  }

  .content {
    width: 75%;
    display: flex;
    flex-direction: column;
    gap: var(--size-gutter-medium);

    img {
      max-width: 100%;
      height: auto;
    }
  }

  .title {
    display: flex;
    justify-content: space-between;

    .title-icon {
      display: flex;
      justify-content: center;
      width: 30px;

      img {
        display: none;
      }
    }
  }

  @media screen and (max-width: 800px) {
    .title .title-icon img {
      display: block;
    }

    .preview {
      span {
        width: 100%;
      }

      .image {
        display: none;
      }
    }

    .content {
      width: 100%;
    }
  }
</style>
