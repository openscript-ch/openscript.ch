---
import { currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection } from "astro:content";
import Accordion from "../../components/accordion/Accordion.astro";
import AccordionItem from "../../components/accordion/AccordionItem.astro";
import Heading from "../../components/accordion/Heading.astro";
import { Image } from "astro:assets";

const locale = currentLocale.get();
const projects = await getCollection("referenceProjects", (entry) => entry.data.locale === locale);
---

<Accordion>
  {
    projects.map((project, i) => (
      <AccordionItem
        id={project.id}
        name={project.data.softwareName}
        variant="minimal"
        open={i === 0}
      >
        <div slot="pretext">
          <Heading level = "h3" size = "h6" class="accordion-title" slot="title">
            {project.data.softwareName}
            <Image height="30" src={project.data.logo} alt={project.data.softwareName} />
          </Heading>
          <div class="preview">
            <span>{project.data.summary}</span>
            <div class="image">
              <Image src={project.data.logo} alt={project.data.softwareName} />
            </div>
          </div>
        </div>
        <div class="content">{project.data.summary}</div>
      </AccordionItem>
    ))
  }
</Accordion>

<style>
  .preview {
    display: flex;
    gap: 5rem;
    justify-content: space-between;

    span {
      width: 80%;
    }

    .image {
      width: 20%;
      display: flex;
      justify-content: center;
    }
  }

  .content {
    width: 80%;
  }

  .accordion-title {
    display: flex;
    justify-content: space-between;

    img {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .accordion-title img {
      display: block;
    }

    .preview {
      span {
        width: 100%;
      }

      .image {
        display: none;
      }
    }

    .content {
      width: 100%;
    }
  }
</style>
