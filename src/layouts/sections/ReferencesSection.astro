---
import { currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection, render } from "astro:content";
import Accordion from "../../components/accordion/Accordion.astro";
import AccordionItem from "../../components/accordion/AccordionItem.astro";
import Heading from "../../components/accordion/Heading.astro";
import { Image } from "astro:assets";

const locale = currentLocale.get();
const rawProjects = await getCollection("referenceProjects", (entry) => entry.data.locale === locale);

const projects = await Promise.all(
  rawProjects.map(async (project) => {
    const { Content, headings } = await render(project);
    return {
      ...project,
      Content,
      headings,
    };
  }),
);
---

<Accordion>
  {projects.map(({ id, data, Content }, i) => (
    <AccordionItem id={id} name={data.softwareName} variant="minimal" open={i === 0}>
      <div slot="pretext">
        <Heading level="h3" size="h6" class="title" slot="title">
          {data.softwareName}
          <div class="title-icon">
            <Image height="30" src={data.logo} alt={data.softwareName} />
          </div>
        </Heading>
        <div class="preview">
          <span>{data.summary}</span>
          <div class="image">
            <Image height={120} src={data.logo} alt={data.softwareName} />
          </div>
        </div>
      </div>
      <div class="content">
        <Content />
      </div>
    </AccordionItem>
  ))}
</Accordion>

<style>
  .preview {
    display: flex;
    justify-content: space-between;
    gap: var(--size-gutter-huge);

    span {
      width: 75%;
    }

    .image {
      display: flex;
      flex-grow: 1;
      justify-content: center;
    }
  }

  .content {
    width: 75%;
    display: flex;
    flex-direction: column;
    gap: var(--size-gutter-medium);

    img {
      max-width: 100%;
      height: auto;
    }
  }

  .title {
    display: flex;
    justify-content: space-between;

    .title-icon {
      display: flex;
      justify-content: center;
      width: 30px;

      img {
        display: none;
      }
    }
  }

  @media screen and (max-width: 800px) {
    .title .title-icon img {
      display: block;
    }

    .preview {
      span {
        width: 100%;
      }

      .image {
        display: none;
      }
    }

    .content {
      width: 100%;
    }
  }
</style>
