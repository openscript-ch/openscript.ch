---
import Carousel from "../../components/Carousel.astro";
---

<section>
  <Carousel>
    <slot />
    <slot name="overlay" slot="overlay" />
  </Carousel>
</section>

<style>
  section :global(.carousel) {
    height: 60rem;
    max-height: 80vh;

    :global(.background-icon img) {
      margin-inline-end: calc(var(--size-page-padding) + 7rem);
    }

    :global(.prev) {
      left: var(--size-page-padding);
    }

    :global(.next) {
      right: var(--size-page-padding);
    }

    :global(.carousel-overlay > div) {
      color: var(--color-white);
      font-size: 1.6rem;
      font-weight: bold;
      height: 100%;
      padding: 0 var(--size-page-padding);

      &:global(.active) {
        display: flex;
        flex-direction: column;
      }

      &:global(.align-center) {
        align-items: center;
        justify-content: center;
      }

      &:global(.align-end) {
        align-items: flex-end;
        justify-content: center;

        > :global(*) {
          width: 45%;
        }
      }

      &:global(.align-start) {
        align-items: flex-start;
        justify-content: center;

        > :global(*) {
          width: 60%;
        }
      }

      :global(.button) {
        font-size: 1.2rem;
        color: var(--color-white);
      }

      :global(h3) {
        margin: 0;
        font-size: 1.7rem;
      }
    }

    @media screen and (max-width: 1025px) {
      :global(.background-icon) {
        align-items: flex-start;
        justify-content: center;

        :global(img) {
          margin-inline-end: 0;
          margin-block-start: 10%;
        }
      }
      :global(.carousel-overlay) {
        padding-block-end: 10%;
      }

      :global(.carousel-overlay > div:is(.align-start, .align-center, .align-end)) {
        align-items: center;
        justify-content: flex-end;
        font-size: 1.2rem;
        padding: 0;

        > :global(*) {
          width: 95%;
        }
      }
    }

    @media screen and (max-width: 640px) {
      :global(.background-icon) {
        :global(img) {
          margin-block-start: 20%;
        }
      }
      :global(.carousel-overlay) {
        padding-block-end: 20%;
      }
    }
  }
</style>
