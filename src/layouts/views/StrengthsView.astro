---
import { currentLocale, useI18n } from "astro-nanostores-i18n:runtime";
import { getCollection, render } from "astro:content";
import type { ComponentProps } from "astro/types";
import Button from "../../components/Button.astro";
import Divider from "../../components/Divider.astro";
import Sprite from "../../components/Sprite.astro";
import SpriteData from "../../../res/sprite/sprite.json";
import { getContentAnchor, resolveSimplePath } from "../../utils/paths";

type SpriteName = ComponentProps<typeof Sprite>["name"];

const isSpriteName = (name: string): name is SpriteName =>
  Object.hasOwn(SpriteData, name);

const locale = currentLocale.get();
const translations = useI18n("strengths.view", {
  references: "Passende Referenzen",
});
const [services, strengths, projects, servicesPath, referencesPath] =
  await Promise.all([
    getCollection("services", (entry) => entry.data.locale === locale),
    getCollection("strengths", (entry) => entry.data.locale === locale),
    getCollection("referenceProjects", (entry) => entry.data.locale === locale),
    resolveSimplePath("main", "/future/services", locale),
    resolveSimplePath("main", "/past/references", locale),
  ]);

services.sort((first, second) => first.data.order - second.data.order);
strengths.sort((first, second) =>
  first.data.strengthName.localeCompare(second.data.strengthName, locale),
);
projects.sort((first, second) =>
  first.data.projectName.localeCompare(second.data.projectName, locale),
);

const serviceIds = new Set(services.map((service) => service.id));
const strengthIds = new Set(strengths.map((strength) => strength.id));

for (const project of projects) {
  for (const { strength } of project.data.strengths) {
    if (strength.collection !== "strengths" || !strengthIds.has(strength.id)) {
      throw new Error(
        `Unknown strength ${JSON.stringify(Array.from(strengthIds))} referenced by project ${project.id}`,
      );
    }
  }
}

const renderedStrengths = await Promise.all(
  strengths.map(async (strength) => {
    const { service, sprite } = strength.data;
    if (service.collection !== "services" || !serviceIds.has(service.id)) {
      throw new Error(
        `Unknown service ${service.id} referenced by strength ${strength.id}`,
      );
    }
    if (!isSpriteName(sprite)) {
      throw new Error(`Unknown sprite ${sprite} for strength ${strength.id}`);
    }
    const { Content } = await render(strength);
    return {
      ...strength,
      sprite,
      Content,
      relatedProjects: projects.filter((project) =>
        project.data.strengths.some(
          (projectStrength) => projectStrength.strength.id === strength.id,
        ),
      ),
    };
  }),
);

const groups = services.map((service) => ({
  data: service.data,
  strengths: renderedStrengths.filter(
    (strength) => strength.data.service.id === service.id,
  ),
}));
---

{groups.map(({ data: service, strengths: serviceStrengths }, index) => (
  <>
    {index > 0 && (
      <Divider
        firstSegmentColor="var(--color-white)"
        flipVertical={index % 2 === 0}
        fixAntialiasingTop={index % 2 === 0}
        fixAntialiasingBottom={index % 2 === 1}
      />
    )}
    <section class:list={{ "white-background": index % 2 === 1 }}>
      <h2>
        <Button
          href={`${servicesPath}#${getContentAnchor(service.translationId)}`}
          withArrow
        >
          {service.serviceName}
        </Button>
      </h2>
      <ul class="strengths-list">
        {serviceStrengths.map(
          ({ id, data, sprite, Content, relatedProjects }) => (
            <li id={getContentAnchor(data.translationId)} class="strength-card">
              <header>
                <span aria-hidden="true">
                  <Sprite name={sprite} />
                </span>
                <h3>
                  <a href={`#${getContentAnchor(data.translationId)}`}>
                    {data.strengthName}
                  </a>
                </h3>
              </header>
              <Content />
              {relatedProjects.length > 0 && (
                <div class="references">
                  <h4>{translations.references}</h4>
                  <ul>
                    {relatedProjects.map((project) =>
                      project.data.strengths
                        .filter(
                          (projectStrength) =>
                            projectStrength.strength.id === id,
                        )
                        .map((projectStrength) => (
                          <li>
                            <a href={`${referencesPath}#${project.id}`}>
                              {project.data.projectName}
                            </a>
                            : {projectStrength.description}
                          </li>
                        )),
                    )}
                  </ul>
                </div>
              )}
            </li>
          ),
        )}
      </ul>
    </section>
  </>
))}

<style>
  .strengths-list {
    display: flex;
    flex-direction: column;
    gap: var(--size-gutter-big);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .strength-card {
    min-width: 0;
    padding: var(--size-gutter-medium);
    background-color: var(--color-white);
    font-size: 1.125rem;
    overflow-wrap: anywhere;
    scroll-margin-block-start: var(--size-gutter-big);

    &:target {
      outline: 2px solid var(--color-primary);
      outline-offset: 4px;
    }

    header {
      display: flex;
      align-items: flex-start;
      gap: var(--size-gutter);

      span {
        flex-shrink: 0;
      }

      :global(svg) {
        width: 2.5rem;
        height: auto;
      }
    }

    h3 {
      margin: 0;
    }
  }

  .white-background .strength-card {
    background-color: var(--color-background);
  }

  .references {
    margin-block-start: var(--size-gutter-medium);

    h4 {
      margin: 0 0 var(--size-gutter);
    }

    ul {
      padding-inline-start: var(--size-gutter-medium);
    }
  }
</style>
